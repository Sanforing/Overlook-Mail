# --- Required ---
PORT=8787
HOST=0.0.0.0

# Where to put the SQLite database file (created if missing).
DATA_DIR=./data

# Where uploaded files (novels, ROMs) live on disk.
UPLOAD_DIR=./data/uploads

# A long random string. Used to sign session cookies. Rotate carefully.
SESSION_SECRET=change-me-to-a-long-random-string

# Public origin of the site (no trailing slash). Used to build OAuth
# redirect URIs and to set the Secure cookie + CORS allowlist.
PUBLIC_ORIGIN=http://localhost:8787

# Comma-separated list of additional allowed origins (CORS).
# Useful when you serve the static frontend from a different host/port.
EXTRA_ALLOWED_ORIGINS=http://localhost:8080

# --- Static frontend (optional) ---
# If set, the server also serves the static frontend from this folder.
# When unset, you must serve the frontend separately and point CORS at it.
SERVE_STATIC_FROM=../

# --- OAuth (all optional — providers without credentials are disabled) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# --- Limits ---
MAX_UPLOAD_BYTES=52428800   # 50 MiB
ROM_MAX_BYTES=52428800
NOVEL_MAX_BYTES=10485760    # 10 MiB

# --- Misc ---
ALLOW_REGISTRATION=true
DEFAULT_TIER=free
